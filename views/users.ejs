<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Datafeed // Node Mongoose</title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="p-6 md:p-12">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between pb-6 mb-8 border-b border-gray-800 gap-4">
            <div>
                <div class="text-xs text-amber-400 uppercase tracking-widest">// LOCALHOST:27017/USERDEMO</div>
                <h1 class="text-3xl font-black text-white mt-1" style="font-family: 'Syne', sans-serif;">ACTIVE
                    IDENTITIES</h1>
            </div>
            <div class="flex gap-3">
                <a href="/create" class="cyber-btn cyber-btn-amber text-xs">+ ADD RECORD</a>
                <a href="/" class="cyber-btn cyber-btn-ghost text-xs">&lt; ROOT</a>
            </div>
        </div>

        <!-- User Grid / List -->
        <% if (users.length===0) { %>
            <div class="terminal-card p-8 text-center text-gray-500">
                [NO IDENTITIES CURRENTLY LOGGED IN DATABASE]
            </div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <% users.forEach(user=> { %>
                        <div class="terminal-card p-5 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center justify-between mb-3 text-xs text-gray-500">
                                    <span>UID: <%= user._id.toString().substring(18) %></span>
                                    <span class="text-cyan-400">ACTIVE</span>
                                </div>
                                <h2 class="text-xl font-bold text-white tracking-wide">
                                    <%= user.name %>
                                </h2>
                                <p class="text-sm text-amber-400 mt-1 font-mono break-all">&gt; <%= user.email %>
                                </p>
                            </div>

                            <div class="pt-5 mt-4 border-t border-gray-800/80 flex items-center justify-end">
                                <a href="/update/<%= user._id %>" class="cyber-btn cyber-btn-ghost text-xs !py-1 !px-3">
                                    [EDIT_PARAM]
                                </a>
                            </div>
                        </div>
                        <% }) %>
                </div>
                <% } %>
    </div>
</body>

</html>