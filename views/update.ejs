<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modify Payload // <%= user.name %>
    </title>
    <link rel="stylesheet" href="/output.css">
</head>

<body class="flex items-center justify-center p-6">
    <div class="terminal-card w-full max-w-md p-8 border">
        <div class="border-b border-gray-800 pb-3 mb-6">
            <span class="text-xs text-amber-400 uppercase tracking-widest">// OVERRIDE RECORD: <%=
                    user._id.toString().substring(18) %></span>
            <h1 class="text-2xl font-bold text-white mt-1" style="font-family: 'Syne', sans-serif;">UPDATE RECORD</h1>
        </div>

        <form action="/update/<%= user._id %>" method="POST" class="space-y-5">
            <div>
                <label class="block text-xs uppercase text-gray-400 tracking-wider mb-2">&gt; USERNAME_FIELD</label>
                <input type="text" name="name" value="<%= user.name %>" required
                    class="cyber-input w-full p-3 text-sm" />
            </div>

            <div>
                <label class="block text-xs uppercase text-gray-400 tracking-wider mb-2">&gt; NETWORK_EMAIL</label>
                <input type="email" name="email" value="<%= user.email %>" required
                    class="cyber-input w-full p-3 text-sm" />
            </div>

            <div class="pt-4 flex gap-4">
                <button type="submit" class="cyber-btn cyber-btn-amber text-xs w-full">
                    SYNC_CHANGES
                </button>
                <a href="/users" class="cyber-btn cyber-btn-ghost text-xs text-center flex items-center justify-center">
                    CANCEL
                </a>
            </div>
        </form>
    </div>
</body>

</html>